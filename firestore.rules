rules_version = '2';

// Everything lives under users/{uid} and only the account owner reads or writes it.
// admin, email and createdAt on the profile are not editable from the app.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validYear(y) {
      return y is int && y >= 1900 && y <= 2100;
    }

    function validUser(d) {
      return d.name is string && d.name.size() <= 80
        && (d.get('birthYear', null) == null || validYear(d.birthYear))
        && d.isParent is bool
        && d.hidden is bool;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validUser(request.resource.data) && !('admin' in request.resource.data);
      allow update: if owner(uid) && validUser(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'email', 'createdAt']);

      // children of a parent account
      match /players/{pid} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && validYear(request.resource.data.birthYear)
          && request.resource.data.get('hidden', false) is bool;
      }

      // what v1 left (questions mastered before the rewrite), written by the migration only
      match /archive/{key} {
        allow read: if owner(uid);
      }

      // {playerKey}~{book}: read chapters, highlights, mastered and missed questions, exam scores
      match /progress/{key} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && key.matches('^[A-Za-z0-9]{1,128}~[12]-samuel$')
          && request.resource.data.get('read', []).size() <= 31
          && request.resource.data.get('marks', []).size() <= 3000
          && request.resource.data.get('mastered', []).size() <= 5000
          && request.resource.data.get('wrong', []).size() <= 5000;
      }
    }

    function admin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // A player flags a question as wrong. Any signed-in player sends one; only admins read, close or delete them.
    match /reports/{id} {
      allow read, update, delete: if admin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'by', 'qid', 'book', 'ch', 'ref', 'q', 'reason', 'note', 'done', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.by is string && request.resource.data.by.size() <= 80
        && request.resource.data.qid is string && request.resource.data.qid.size() <= 60
        && request.resource.data.book in ['1-samuel', '2-samuel']
        && request.resource.data.ch is int
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 60
        && request.resource.data.q is string && request.resource.data.q.size() <= 500
        && request.resource.data.reason in ['answer', 'text', 'unclear', 'typo', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.done == false
        && request.resource.data.at == request.time;
    }

    // Public boards, one per book: boards/{book}/players/{uid}~{playerKey}. Everyone reads them;
    // only the account writes its own players, and the score must equal the questions mastered in its progress.
    match /boards/{book}/players/{key} {
      allow read: if true;
      allow delete: if request.auth != null && key.split('~')[0] == request.auth.uid;
      allow create, update: if request.auth != null
        && key.split('~')[0] == request.auth.uid
        && book in ['1-samuel', '2-samuel']
        && request.resource.data.keys().hasOnly(['name', 'age', 'score', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.age in ['sub12', '12-13', '14-15', '16-17', '18+']
        && request.resource.data.score is int
        && request.resource.data.score == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/progress/$(key.split('~')[1] + '~' + book)).data.mastered.size()
        && request.resource.data.at == request.time;
    }
  }
}
