rules_version = '2';

// Everything lives under users/{uid} and only the account owner reads or writes it. Admins read and manage every account from the admin page.
// admin, email and createdAt on the profile are not editable by the owner; an admin can set admin, never email or createdAt.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validYear(y) {
      return y is int && y >= 1900 && y <= 2100;
    }

    // a player of the account: the adult (key = uid) or one of its children
    function player(uid, pk) {
      return pk == uid || exists(/databases/$(database)/documents/users/$(uid)/players/$(pk));
    }

    function validUser(d) {
      return d.name is string && d.name.size() <= 80
        && (d.get('birthYear', null) == null || validYear(d.birthYear))
        && d.isParent is bool;
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if (owner(uid) && validUser(request.resource.data) && !('admin' in request.resource.data))
        || (admin() && validUser(request.resource.data) && request.resource.data.get('admin', false) is bool);
      allow update: if (owner(uid) && validUser(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'email', 'createdAt']))
        || (admin() && validUser(request.resource.data) && request.resource.data.get('admin', false) is bool
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'createdAt']));
      allow delete: if admin();

      // children of a parent account
      match /players/{pid} {
        allow read: if owner(uid) || admin();
        allow delete: if owner(uid) || admin();
        allow create, update: if (owner(uid) || admin())
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && (request.resource.data.get('birthYear', null) == null || validYear(request.resource.data.birthYear));
      }

      // what v1 left (questions mastered before the rewrite), written by the migration only
      match /archive/{key} {
        allow read: if owner(uid) || admin();
        allow delete: if admin();
      }

      // {playerKey}~{book}: read chapters, highlights, mastered and missed questions, exam scores
      match /progress/{key} {
        allow read: if owner(uid) || admin();
        allow delete: if owner(uid) || admin();
        allow create, update: if owner(uid)
          && key.matches('^[A-Za-z0-9_-]{1,128}~[12]-samuel$')
          && player(uid, key.split('~')[0])
          && request.resource.data.get('read', []).size() <= 31
          && request.resource.data.get('marks', []).size() <= 3000
          // no more than the questions of a book (2 Samuel: 1728)
          && request.resource.data.get('mastered', []).size() <= 2500
          && request.resource.data.get('wrong', []).size() <= 5000;
      }
    }

    // The admin page reads every child and every progress in one query each.
    match /{path=**}/players/{pid} {
      allow read: if admin();
    }
    match /{path=**}/progress/{key} {
      allow read: if admin();
    }

    function admin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // A player flags a question as wrong. Any signed-in player sends one; only admins read, close or delete them.
    match /reports/{id} {
      allow read, update, delete: if admin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'by', 'qid', 'book', 'ch', 'ref', 'q', 'reason', 'note', 'done', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.by is string && request.resource.data.by.size() <= 80
        && request.resource.data.qid is string && request.resource.data.qid.size() <= 60
        && request.resource.data.book in ['1-samuel', '2-samuel']
        && request.resource.data.ch is int
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 60
        && request.resource.data.q is string && request.resource.data.q.size() <= 500
        && request.resource.data.reason in ['answer', 'text', 'unclear', 'hard', 'typo', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.done == false
        && request.resource.data.at == request.time;
    }

    // Public boards. Everyone reads them; an account writes only its own players.
    //   boards/{book}/players/{uid}~{playerKey}: score = questions known in the book, and it must equal the questions mastered in the progress.
    //   lv (per level), ct (per chapter) and ch (per chapter and level) feed the boards by level and by chapter. Their total can only be bounded by the score.
    //   boards/all/players/{uid}~{playerKey}: the same player across every book; the score is the sum of both progress documents.
    function known(path) {
      return existsAfter(path) ? getAfter(path).data.get('mastered', []).size() : 0;
    }

    match /boards/{book}/players/{key} {
      allow read: if true;
      allow delete: if (request.auth != null && key.split('~')[0] == request.auth.uid) || admin();
      allow create, update: if request.auth != null
        && key.split('~')[0] == request.auth.uid
        && player(request.auth.uid, key.split('~')[1])
        && book in ['1-samuel', '2-samuel']
        && request.resource.data.keys().hasOnly(['name', 'age', 'score', 'at', 'lv', 'ct', 'ch'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.get('age', '18+') in ['sub12', '12-13', '14-15', '16-17', '18+']
        && request.resource.data.score is int
        && request.resource.data.score == known(/databases/$(database)/documents/users/$(request.auth.uid)/progress/$(key.split('~')[1] + '~' + book))
        && request.resource.data.get('lv', {}) is map
        && request.resource.data.get('ct', {}) is map
        && request.resource.data.get('ch', {}) is map
        && request.resource.data.get('lv', {}).get('a', 0) + request.resource.data.get('lv', {}).get('b', 0)
          + request.resource.data.get('lv', {}).get('c', 0) + request.resource.data.get('lv', {}).get('d', 0)
          + request.resource.data.get('lv', {}).get('e', 0) <= request.resource.data.score
        && request.resource.data.at == request.time;
    }

    match /boards/all/players/{key} {
      allow read: if true;
      allow delete: if (request.auth != null && key.split('~')[0] == request.auth.uid) || admin();
      allow create, update: if request.auth != null
        && key.split('~')[0] == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.score is int
        && request.resource.data.score == known(/databases/$(database)/documents/users/$(request.auth.uid)/progress/$(key.split('~')[1] + '~1-samuel'))
          + known(/databases/$(database)/documents/users/$(request.auth.uid)/progress/$(key.split('~')[1] + '~2-samuel'))
        && request.resource.data.at == request.time;
    }
  }
}
