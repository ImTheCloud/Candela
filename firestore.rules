rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - name: string (required, 1..80 chars) - User's full display name (Last First)
//   - email: string (optional, max 120 chars) - User email (immutable by owner)
//   - birthYear: int (optional, 1900..2100) - Year of birth
//   - isParent: bool (required) - True if parent account managing children
//   - admin: bool (optional, immutable by owner, admin-only) - Admin privileges
//   - createdAt: timestamp (optional, immutable on update) - Account creation timestamp
//   - lastSeen: timestamp (optional) - Daily visit timestamp
//   - hidden: bool (optional) - Migration flag
//   - migratedFromV1: bool (optional) - Migration flag
//
// Subcollection: users/{uid}/players
// Document ID: {pid} (Child player key)
// Fields:
//   - name: string (required, 1..40 chars) - Child's first name
//   - birthYear: int (optional, 1900..2100) - Child's birth year
//   - createdAt: timestamp (optional) - Creation timestamp
//   - hidden: bool (optional) - Migration flag
//
// Subcollection: users/{uid}/archive
// Document ID: {key} (Legacy v1 archive data from migration)
// Fields:
//   - mastered: list of strings (optional)
//   - count: int (optional)
//   - exportedAt: timestamp (optional)
//
// Subcollection: users/{uid}/progress
// Document ID: {key} (format: {playerKey}~{book}, where book is '1-samuel' or '2-samuel')
// Fields:
//   - mastered: list of string question IDs (max 2500)
//   - wrong: list of string question IDs (max 5000)
//   - marks: list of strings (max 3000)
//   - read: list of int/string chapters (max 31)
//   - exams: map of exam results
//   - stats: map of question type statistics
//   - lv: map of per-level question stats
//   - updatedAt: timestamp (optional)
//
// Collection: reports
// Document ID: {id} (Auto-generated)
// Fields:
//   - uid: string (required, matches auth.uid)
//   - by: string (required, max 80 chars)
//   - qid: string (required, max 60 chars)
//   - book: string (required, in ['1-samuel', '2-samuel'])
//   - ch: int (required)
//   - ref: string (required, max 60 chars)
//   - q: string (required, max 500 chars)
//   - reason: string (required, in ['answer', 'text', 'unclear', 'hard', 'typo', 'other'])
//   - note: string (required, max 1000 chars)
//   - done: bool (required, initially false)
//   - at: timestamp (required, request.time)
//
// Collection: messages
// Document ID: {id} (Auto-generated)
// Fields:
//   - uid: string (required, matches auth.uid)
//   - by: string (required, max 80 chars)
//   - email: string (required, max 120 chars)
//   - message: string (required, 1..3000 chars)
//   - done: bool (required, initially false)
//   - at: timestamp (required, request.time)
//
// Collection: boards/{book}/players
// Document ID: {key} (format: {uid}~{playerKey})
// Fields:
//   - name: string (required, max 40 chars)
//   - score: int (required, equals mastered.size in progress)
//   - at: timestamp (required, request.time)
//   - age: string (optional, in ['sub12', '12-13', '14-15', '16-17', '18+'])
//   - lv: map (optional)
//   - ct: map (optional)
//   - ch: map (optional)
//
// Collection: boards/all/players
// Document ID: {key} (format: {uid}~{playerKey})
// Fields:
//   - name: string (required, max 40 chars)
//   - score: int (required, sum of 1-samuel and 2-samuel mastered)
//   - at: timestamp (required, request.time)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function owner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Rock-solid admin verification:
    // 1. Checks custom claims (request.auth.token.admin == true)
    // 2. Safely verifies document existence with exists() before calling get() to avoid CEL evaluation errors during document deletions
    function admin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true)
      );
    }

    function validYear(y) {
      return y is int && y >= 1900 && y <= 2100;
    }

    // A player belonging to the account: the adult (key = uid) or one of their registered children
    function player(uid, pk) {
      return pk == uid || exists(/databases/$(database)/documents/users/$(uid)/players/$(pk));
    }

    function validUser(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && (d.get('birthYear', null) == null || validYear(d.birthYear))
        && d.isParent is bool;
    }

    // ===============================================================
    // Users & Subcollections
    // ===============================================================

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if (owner(uid) && validUser(request.resource.data) && !('admin' in request.resource.data))
        || (admin() && validUser(request.resource.data) && request.resource.data.get('admin', false) is bool);
      allow update: if (owner(uid) && validUser(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'email', 'createdAt']))
        || (admin() && validUser(request.resource.data) && request.resource.data.get('admin', false) is bool
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'createdAt']));
      allow delete: if owner(uid) || admin();

      // Children registered under a parent account
      match /players/{pid} {
        allow read: if owner(uid) || admin();
        allow delete: if owner(uid) || admin();
        allow create, update: if (owner(uid) || admin())
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && (request.resource.data.get('birthYear', null) == null || validYear(request.resource.data.birthYear));
      }

      // Legacy v1 archive data (questions mastered before the rewrite).
      // Both owner and admin can delete when cleaning up or deleting account.
      match /archive/{key} {
        allow read: if owner(uid) || admin();
        allow delete: if owner(uid) || admin();
      }

      // {playerKey}~{book}: read chapters, highlights, mastered and missed questions, exam scores
      match /progress/{key} {
        allow read: if owner(uid) || admin();
        allow delete: if owner(uid) || admin();
        allow create, update: if (owner(uid) || admin())
          && key.matches('^[A-Za-z0-9_-]{1,128}~[12]-samuel$')
          && (admin() || player(uid, key.split('~')[0]))
          && request.resource.data.get('read', []).size() <= 31
          && request.resource.data.get('marks', []).size() <= 3000
          // No more than the questions of a book (2 Samuel: 1728)
          && request.resource.data.get('mastered', []).size() <= 2500
          && request.resource.data.get('wrong', []).size() <= 5000;
      }
    }

    // Collection group queries: the admin page reads all children and all progress in one query each.
    match /{path=**}/players/{pid} {
      allow read: if admin();
    }
    match /{path=**}/progress/{key} {
      allow read: if admin();
    }

    // ===============================================================
    // Question Reports
    // ===============================================================

    // A player flags a question as wrong. Any signed-in player can submit; only admins read, update, or delete.
    match /reports/{id} {
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.done is bool;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['uid', 'by', 'qid', 'book', 'ch', 'ref', 'q', 'reason', 'note', 'done', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.by is string && request.resource.data.by.size() <= 80
        && request.resource.data.qid is string && request.resource.data.qid.size() <= 60
        && request.resource.data.book in ['1-samuel', '2-samuel']
        && request.resource.data.ch is int
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 60
        && request.resource.data.q is string && request.resource.data.q.size() <= 500
        && request.resource.data.reason in ['answer', 'text', 'unclear', 'hard', 'typo', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.done == false
        && request.resource.data.at == request.time;
    }

    // ===============================================================
    // Contact Messages
    // ===============================================================

    // User-to-admin contact messages sent from user profile. Only admins read, update, or delete.
    match /messages/{id} {
      allow read, delete: if admin();
      allow update: if admin() && request.resource.data.done is bool;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['uid', 'by', 'email', 'message', 'done', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.by is string && request.resource.data.by.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 3000
        && request.resource.data.done == false
        && request.resource.data.at == request.time;
    }

    // ===============================================================
    // Public Leaderboards
    // ===============================================================

    function known(path) {
      return existsAfter(path) ? getAfter(path).data.get('mastered', []).size() : 0;
    }

    function validBoardName() {
      return request.resource.data.name is string && request.resource.data.name.size() <= 40;
    }

    function canUpdateBoardName(key) {
      return ((isAuthenticated() && key.matches('^[A-Za-z0-9_-]+~[A-Za-z0-9_-]+$') && key.split('~')[0] == request.auth.uid && player(request.auth.uid, key.split('~')[1])) || admin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validBoardName();
    }

    function validBookBoard(book, key) {
      return isAuthenticated()
        && key.matches('^[A-Za-z0-9_-]+~[A-Za-z0-9_-]+$')
        && key.split('~')[0] == request.auth.uid
        && player(request.auth.uid, key.split('~')[1])
        && book in ['1-samuel', '2-samuel']
        && request.resource.data.keys().hasOnly(['name', 'age', 'score', 'at', 'lv', 'ct', 'ch'])
        && validBoardName()
        && request.resource.data.get('age', '18+') in ['sub12', '12-13', '14-15', '16-17', '18+']
        && request.resource.data.score is int
        && request.resource.data.score == known(/databases/$(database)/documents/users/$(request.auth.uid)/progress/$(key.split('~')[1] + '~' + book))
        && request.resource.data.get('lv', {}) is map
        && request.resource.data.get('ct', {}) is map
        && request.resource.data.get('ch', {}) is map
        && request.resource.data.get('lv', {}).get('a', 0) + request.resource.data.get('lv', {}).get('b', 0)
          + request.resource.data.get('lv', {}).get('c', 0) + request.resource.data.get('lv', {}).get('d', 0)
          + request.resource.data.get('lv', {}).get('e', 0) <= request.resource.data.score
        && request.resource.data.at == request.time;
    }

    function validAllBoard(key) {
      return isAuthenticated()
        && key.matches('^[A-Za-z0-9_-]+~[A-Za-z0-9_-]+$')
        && key.split('~')[0] == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && validBoardName()
        && request.resource.data.score is int
        && request.resource.data.score == known(/databases/$(database)/documents/users/$(request.auth.uid)/progress/$(key.split('~')[1] + '~1-samuel'))
          + known(/databases/$(database)/documents/users/$(request.auth.uid)/progress/$(key.split('~')[1] + '~2-samuel'))
        && request.resource.data.at == request.time;
    }

    match /boards/{book}/players/{key} {
      allow read: if true;
      allow delete: if (isAuthenticated() && key.split('~')[0] == request.auth.uid) || admin();
      allow create: if validBookBoard(book, key)
        || (admin() && validBoardName());
      allow update: if validBookBoard(book, key)
        || canUpdateBoardName(key)
        || (admin() && validBoardName());
    }

    match /boards/all/players/{key} {
      allow read: if true;
      allow delete: if (isAuthenticated() && key.split('~')[0] == request.auth.uid) || admin();
      allow create: if validAllBoard(key)
        || (admin() && validBoardName());
      allow update: if validAllBoard(key)
        || canUpdateBoardName(key)
        || (admin() && validBoardName());
    }
  }
}
