---
import '@fontsource-variable/inter';
import '@fontsource-variable/outfit';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Lamp from '../components/Lamp.astro';
import AccountButton from '../islands/AccountButton';
import BirthYearGate from '../islands/BirthYearGate';

interface Crumb { href: string; label: string }
interface Props {
  title: string;
  description?: string;
  /** Path back up the site, shown above the page title. */
  crumbs?: Crumb[];
}
const { title, description = 'Teste biblice după traducerea Cornilescu: 1 Samuel și 2 Samuel.', crumbs = [] } = Astro.props;
const fullTitle = title === 'Candela' ? title : `${title} · Candela`;
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f1e6" />
    <link rel="icon" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    {import.meta.env.PROD && <script is:inline>if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));</script>}
  </head>
  <body>
    <header class="top">
      <div class="wrap top-row">
        <a href="/" class="brand" aria-label="Candela, acasă">
          <Lamp />
          <span>Candela</span>
        </a>
        <AccountButton client:only="preact">
          <span slot="fallback" class="account-placeholder"></span>
        </AccountButton>
      </div>
    </header>
    <main>
      {crumbs.length > 0 && (
        <nav class="wrap crumbs" aria-label="Unde ești">
          {crumbs.map((c) => <><a href={c.href}>{c.label}</a><span aria-hidden="true">/</span></>)}
          <span aria-current="page">{title}</span>
        </nav>
      )}
      <slot />
    </main>
    <footer class="wrap foot small muted">Textul biblic: traducerea Dumitru Cornilescu, după biblia.resursecrestine.ro.</footer>
    <BirthYearGate client:only="preact" />
  </body>
</html>

<style>
  .top {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top);
  }
  .top-row { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .brand { display: flex; align-items: center; gap: 7px; text-decoration: none; font: 400 25px/1 var(--f-brand); }
  .brand svg { margin: -8px -4px -3px -10px; }
  .account-placeholder { display: block; width: 44px; height: 44px; }
  .crumbs {
    display: flex; align-items: center; gap: 6px; white-space: nowrap;
    padding-top: 20px; font-size: 0.875rem; color: var(--ink-3);
  }
  .crumbs a { flex: none; color: var(--ink-2); text-decoration: none; }
  .crumbs [aria-current] { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .crumbs a:hover { color: var(--oil-ink); text-decoration: underline; }
  .crumbs [aria-current] { color: var(--ink-2); font-weight: 500; }
  .foot { padding-block: 40px calc(24px + env(safe-area-inset-bottom)); text-align: center; }
</style>
