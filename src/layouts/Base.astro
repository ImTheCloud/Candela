---
import '@fontsource-variable/inter';
import '@fontsource-variable/outfit';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import '../styles/quiz.css';
import { ClientRouter } from 'astro:transitions';
import Lamp from '../components/Lamp.astro';
import AccountButton from '../islands/AccountButton';
import HeaderTitle from '../islands/HeaderTitle';
import { DEFAULT_BOOK } from '../lib/books';

interface Crumb { href: string; label: string }
interface Props {
  title: string;
  description?: string;
  /** Path back up the site; the last one is where the back button goes when there is no history. */
  crumbs?: Crumb[];
  /** A home page: no back button. */
  home?: boolean;
  /** The back button always goes to the page above (never back in the history): the Bible reader, where history is only chapters. */
  backUp?: boolean;
  /** "Bun venit, {prenume}" in the header instead of the site name (enabled on all pages by default). */
  greet?: boolean;
}
const { title, description = 'Teste biblice după traducerea Cornilescu: 1 Samuel și 2 Samuel.', crumbs = [], home = false, backUp = false, greet = true } = Astro.props;
const up = crumbs.at(-1)?.href ?? '/';
const parent = up === `/${DEFAULT_BOOK}` ? '/' : up;
const fullTitle = title === 'Candela' ? title : `${title} · Candela`;
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f1e6" />
    <link rel="icon" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Candela" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Candela: lampa cu untdelemn" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <ClientRouter />
    <slot name="head" />
    <script is:inline>
      // no offline version any more: remove what an older visit installed
      if ('serviceWorker' in navigator) navigator.serviceWorker.getRegistrations().then((rs) => rs.forEach((r) => r.unregister())).catch(() => {});
      if (window.caches) caches.keys().then((ks) => ks.forEach((k) => caches.delete(k))).catch(() => {});
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-row">
        {!home && (
          <a class="back" href={parent} data-back={backUp ? undefined : ''} aria-label="Înapoi">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </a>
        )}
        <a href="/" class="brand" aria-label="Candela, acasă">
          <Lamp />
          {greet
            ? <HeaderTitle client:only="preact"><span slot="fallback" id="brand-fb" class="brand-text">Candela</span></HeaderTitle>
            : <span class="brand-text">Candela</span>}
        </a>
        <div id="quiz-top" class="qt"></div>
        <AccountButton client:only="preact">
          <a slot="fallback" id="acct-fb" href="/cont" class="account-placeholder" hidden></a>
        </AccountButton>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<script is:inline>
  // The account button & brand title are islands: until they load, show what the last visit left so they do not pop in late.
  try {
    var acct = JSON.parse(localStorage.getItem('acct') || 'null'), fb = document.getElementById('acct-fb');
    if (fb && typeof acct === 'string' && !(acct === '' && location.pathname.indexOf('/cont') === 0)) {
      if (acct) { fb.className = 'avatar'; fb.textContent = acct; var n = parseInt(localStorage.getItem('acctN') || '0', 10); if (n > 0) { var s = document.createElement('span'); s.className = 'badge-n'; s.textContent = n > 9 ? '9+' : String(n); fb.appendChild(s); fb.href = '/semnalari'; } } else { fb.className = 'btn btn-primary btn-sm'; fb.textContent = 'Intră'; }
      fb.hidden = false;
    }
    var me = JSON.parse(localStorage.getItem('me') || 'null'), bfb = document.getElementById('brand-fb');
    if (bfb && me && me.name) {
      var f = me.name.trim().split(/\s+/)[0];
      if (f) bfb.textContent = 'Bun venit, ' + f;
    }
  } catch (e) {}
</script>

<script>
  // Back goes to the previous page of the app (no reload); with nothing behind it, up to the parent page.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a[data-back]');
    if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
    if ((history.state?.index ?? 0) > 0) { e.preventDefault(); history.back(); }
  }, true);

  document.addEventListener('astro:page-load', () => {
    try {
      var me = JSON.parse(localStorage.getItem('me') || 'null'), bfb = document.getElementById('brand-fb');
      if (bfb && me && me.name) {
        var f = me.name.trim().split(/\s+/)[0];
        if (f) bfb.textContent = 'Bun venit, ' + f;
      }
    } catch (e) {}
  });
</script>

<style>
  .top {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top);
  }
  .top-row { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .brand { display: flex; align-items: center; gap: 7px; min-width: 0; text-decoration: none; font: 400 25px/1 var(--f-brand); }
  .brand-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .brand :global(.lamp) { margin: -8px -4px -3px -10px; }
  .account-placeholder { display: block; width: 44px; height: 44px; }
  .top-row { gap: 6px; }
  .brand { margin-right: auto; }
  .back {
    flex: none; display: grid; place-items: center; width: 40px; height: 40px; margin-left: -8px;
    border-radius: 50%; color: var(--ink); text-decoration: none;
  }
  .back:active { background: var(--surface-2); }
</style>
