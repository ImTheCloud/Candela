---
import '@fontsource-variable/inter';
import '@fontsource-variable/outfit';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import '../styles/quiz.css';
import { ClientRouter } from 'astro:transitions';
import Lamp from '../components/Lamp.astro';
import AccountButton from '../islands/AccountButton';
import HeaderTitle from '../islands/HeaderTitle';
import { DEFAULT_BOOK } from '../lib/books';

interface Crumb { href: string; label: string }
interface Props {
  title: string;
  description?: string;
  /** Path back up the site; the last one is where the back button goes when there is no history. */
  crumbs?: Crumb[];
  /** A home page: no back button. */
  home?: boolean;
  /** The back button always goes to the page above (never back in the history): the Bible reader, where history is only chapters. */
  backUp?: boolean;
  /** "Bun venit, {prenume}" in the header instead of the site name (enabled on all pages by default). */
  greet?: boolean;
  /** The back button shows only when signed in (the account page: the sign-in form when signed out, the profile when signed in). */
  backSignedIn?: boolean;
  /** A page title in the header instead of the site name and the account button (the Bible reader). */
  heading?: { title: string; note?: string; sub?: string };
  /** Hide the top header completely (login, signup, reset password) */
  noHeader?: boolean;
}
const {
  title,
  description = 'Pregătire pentru concursul biblic „Talantul în Negoț”: teste din 1 Samuel și 2 Samuel. „...și candela lui Dumnezeu nu se stinsese încă...” (1 Samuel 3:3)',
  crumbs = [],
  home = false,
  backUp = false,
  backSignedIn = false,
  heading,
  noHeader = false
} = Astro.props;
const up = crumbs.at(-1)?.href ?? '/';
const parent = up === `/${DEFAULT_BOOK}` ? '/' : up;
const fullTitle = title === 'Candela' ? title : `${title} – Candela`;
---
<!doctype html>
<html lang="ro" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfaf5" />
    <link rel="icon" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Candela" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Candela: lampa cu untdelemn" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <script is:inline>
      // The site is played from an account: a visit not signed in goes to sign-in at once (the account pages stay open).
      try {
        if (localStorage.getItem('me')) document.documentElement.classList.add('signed-in');
        else if (location.pathname.indexOf('/cont') !== 0) location.replace('/cont?next=' + encodeURIComponent(location.pathname + location.search));
      } catch (e) {}
    </script>
    <ClientRouter />
    <slot name="head" />
    <script is:inline>
      // no offline version any more: remove what an older visit installed
      if ('serviceWorker' in navigator) navigator.serviceWorker.getRegistrations().then((rs) => rs.forEach((r) => r.unregister())).catch(() => {});
      if (window.caches) caches.keys().then((ks) => ks.forEach((k) => caches.delete(k))).catch(() => {});
    </script>
  </head>
  <body class={noHeader ? 'auth-no-header' : undefined}>
    {!noHeader && (
      <header class="top">
        <div class="wrap top-row">
          {!home && (
            <a class={`back${backSignedIn ? ' back-signed-in' : ''}`} href={parent} data-back={backUp ? undefined : ''} aria-label="Înapoi">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            </a>
          )}
          {heading ? (
            <div class="heading">
              <h1>{heading.title}{heading.note && <span class="heading-note"> ({heading.note})</span>}</h1>
              {heading.sub && <p>{heading.sub}</p>}
            </div>
          ) : (<>
            <a href="/" class="brand" aria-label="Candela, acasă">
              <Lamp />
              <span class="brand-text">Candela</span>
            </a>
            <div id="quiz-top" class="qt"></div>
            <AccountButton client:only="preact">
              <a slot="fallback" id="acct-fb" href="/cont" class="account-placeholder" hidden></a>
            </AccountButton>
          </>)}
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
  </body>
</html>

<script is:inline>
  // The account button is an island: until it loads, show what the last visit left so it does not pop in late.
  try {
    var acct = JSON.parse(localStorage.getItem('acct') || 'null'), fb = document.getElementById('acct-fb');
    if (fb && typeof acct === 'string' && !(acct === '' && location.pathname.indexOf('/cont') === 0)) {
      if (acct) { fb.className = 'avatar'; fb.textContent = acct; var n = parseInt(localStorage.getItem('acctN') || '0', 10); if (n > 0) { var s = document.createElement('span'); s.className = 'badge-n'; s.textContent = n > 9 ? '9+' : String(n); fb.appendChild(s); fb.href = parseInt(localStorage.getItem('acctRep') || '0', 10) > 0 ? '/semnalari' : '/mesaje'; } } else { fb.className = 'btn btn-primary btn-sm'; fb.textContent = 'Intră'; }
      fb.hidden = false;
    }
  } catch (e) {}
</script>

<script>
  // every page checks the account (the Bible reader has no account button that would load it)
  import '../lib/session';

  // Back goes to the previous page of the app (no reload); with nothing behind it, up to the parent page.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a[data-back]');
    if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
    if ((history.state?.index ?? 0) > 0) { e.preventDefault(); history.back(); }
  }, true);
</script>

<style>
  .top {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top);
  }
  .top-row { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .brand { display: flex; align-items: center; gap: 7px; min-width: 0; text-decoration: none; font: 400 21px/1 var(--f-brand); }
  @media (min-width: 440px) {
    .brand { font-size: 24px; }
  }
  .brand-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .brand :global(.lamp) { margin: -8px -4px -3px -10px; }
  .account-placeholder { display: block; width: 44px; height: 44px; }
  .top-row { gap: 6px; }
  .brand { margin-right: auto; }
  .back {
    flex: none; display: grid; place-items: center; width: 40px; height: 40px; margin-left: -8px;
    border-radius: 50%; color: var(--ink); text-decoration: none;
  }
  .back:active { background: var(--surface-2); }
  /* the reader: its back arrow sits right above the chapter arrows of the bottom bar */
  .top-row:has(.heading) .back { width: 48px; height: 48px; margin: 0 4px 0 0; }
  .heading { flex: 1; min-width: 0; display: grid; gap: 1px; }
  .heading h1 { margin: 0; font: 600 1.6rem/1.2 var(--f-display); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .heading-note { font: 500 0.8rem var(--f-body); color: var(--ink-3); }
  .heading p { margin: 0; font: 500 0.88rem/1.2 var(--f-display); color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
