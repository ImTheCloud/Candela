---
import type { Book } from '../lib/books';

// Bottom sheet listing every chapter, opened by any [data-open-sheet] button on the page.
interface Props { book: Book; current: number }
const { book, current } = Astro.props;
const chapters = Array.from({ length: book.chapters }, (_, i) => i + 1);
---
<dialog class="sheet" aria-label={`Capitolele din ${book.name}`}>
  <div class="sheet-head">
    <p class="sheet-title">{book.name}</p>
    <button type="button" class="icon-btn" data-close aria-label="Închide"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
  </div>
  <ol class="sheet-grid" data-book={book.slug}>
    {chapters.map((n) => (
      <li><a href={`/${book.slug}/citire/${n}`} data-astro-prefetch="viewport" data-ch={n} aria-current={n === current ? 'page' : undefined}>{n}</a></li>
    ))}
  </ol>
</dialog>

<script>
  document.addEventListener('astro:page-load', () => {
    const sheet = document.querySelector<HTMLDialogElement>('dialog.sheet');
    if (!sheet) return;
    // closing slides the sheet back down before the dialog really closes
    let closing = false;
    const slideOut = () => {
      if (closing || !sheet.open) return;
      closing = true;
      sheet.classList.add('is-closing');
      setTimeout(() => { sheet.close(); sheet.classList.remove('is-closing'); closing = false; }, 230);
    };
    for (const b of document.querySelectorAll('[data-open-sheet]')) b.addEventListener('click', () => sheet.showModal());
    sheet.addEventListener('click', (e) => { if (e.target === sheet) slideOut(); });
    sheet.querySelector('[data-close]')?.addEventListener('click', slideOut);
    sheet.addEventListener('cancel', (e) => { e.preventDefault(); slideOut(); });
  });
</script>

<style>
  .sheet {
    width: 100%; max-width: 40rem; margin: auto auto 0; padding: 16px 16px calc(20px + env(safe-area-inset-bottom));
    border: 0; border-radius: 20px 20px 0 0; background: var(--surface); color: var(--ink);
    box-shadow: var(--shadow); max-height: 80dvh;
  }
  .sheet[open] { animation: sheet-up .26s cubic-bezier(.2,.8,.2,1); }
  .sheet[open]::backdrop { background: rgb(58 39 27 / 0.4); animation: fade .18s ease-out; }
  .sheet.is-closing { animation: sheet-down .23s cubic-bezier(.4,0,1,1) forwards; }
  .sheet.is-closing::backdrop { animation: fade-out .23s ease-in forwards; }
  @keyframes sheet-up { from { transform: translateY(100%); } }
  @keyframes sheet-down { to { transform: translateY(100%); } }
  @keyframes fade { from { opacity: 0; } }
  @keyframes fade-out { to { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .sheet, .sheet::backdrop { animation: none !important; } }
  .sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .sheet-title { font: 600 1.2rem var(--f-display); }
  .sheet-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(48px, 1fr));
  }
  .sheet-grid a {
    display: grid; place-items: center; aspect-ratio: 1; border-radius: var(--r-sm);
    border: 1px solid var(--line); text-decoration: none; font-weight: 600; font-variant-numeric: tabular-nums;
  }
  .sheet-grid a[aria-current="page"] { border: 2px solid var(--oil); }
</style>
