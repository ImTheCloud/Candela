---
import BookPanel from '../islands/BookPanel';
import PlayerPicker from '../islands/PlayerPicker';
import { BOOKS, type Book } from '../lib/books';
import { summary } from '../lib/content';

// The home page: who plays, then the books' chapters (the two books switch in place).
interface Props { book: Book }
const { book } = Astro.props;
const books = BOOKS.map((b) => ({ slug: b.slug, name: b.name, titles: b.titles, summary: summary(b.slug) }));
---
<h1 class="sr-only">Candela</h1>

<section class="wrap hb-who">
  <PlayerPicker client:only="preact" />
</section>

<BookPanel client:only="preact" books={books} initial={book.slug}>
  <section slot="fallback" class="wrap hb-chap"><div class="card hb-chapters"><div class="tiles-space"></div></div></section>
</BookPanel>

<style>
  .hb-who:has(.picker) { padding-top: 10px; }
  .tiles-space { min-height: 360px; }
</style>
