---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina nu există">
  <section class="wrap narrow page stack">
    <h1>Pagina nu există</h1>
    <p class="muted">Adresa nu este corectă sau pagina a fost mutată.</p>
    <a class="btn btn-primary" href="/">Înapoi acasă</a>
  </section>
</Base>
<style>.page { padding-block: 48px; --gap: 20px; align-items: flex-start; }</style>
