---
import Base from '../layouts/Base.astro';
import FamilyProgress from '../islands/FamilyProgress';
import { BOOKS } from '../lib/books';
import { totals } from '../lib/content';

const books = BOOKS.map((b) => ({ slug: b.slug, name: b.name, chapters: b.chapters, totals: totals(b.slug) }));
---
<Base title="Progres" crumbs={[{ href: '/', label: 'Acasă' }]}>
  <section class="wrap narrow page">
    <h1>Progres</h1>
    <FamilyProgress client:only="preact" books={books}>
      <div slot="fallback" class="card skeleton"></div>
    </FamilyProgress>
  </section>
</Base>
<style>.page { display: grid; gap: 16px; padding-block: 8px 32px; }</style>
