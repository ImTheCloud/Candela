---
import Loader from '../components/Loader.astro';
import Base from '../layouts/Base.astro';
import AdminPage from '../islands/AdminPage';
---
<Base title="Administrare" crumbs={[{ href: '/cont', label: 'Cont' }]}>
  <section class="wrap narrow page">
    <h1>Administrare</h1>
    <a class="link" href="/semnalari">Semnalări de greșeli</a>
    <AdminPage client:only="preact">
      <Loader slot="fallback" />
    </AdminPage>
  </section>
</Base>
<style>.page { display: grid; gap: 16px; padding-block: 8px 32px; }</style>
