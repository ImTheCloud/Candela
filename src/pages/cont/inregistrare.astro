---
import Loader from '../../components/Loader.astro';
import Base from '../../layouts/Base.astro';
import SignUpForm from '../../islands/SignUpForm';
---
<Base title="Cont nou" home crumbs={[{ href: '/cont', label: 'Cont' }]}>
  <section class="wrap narrow page">
    <SignUpForm client:only="preact">
      <Loader slot="fallback" />
    </SignUpForm>
  </section>
</Base>
<style>.page { padding-block: 12px 24px; }</style>
