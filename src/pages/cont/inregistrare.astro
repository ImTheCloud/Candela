---
import Loader from '../../components/Loader.astro';
import Base from '../../layouts/Base.astro';
import SignUpForm from '../../islands/SignUpForm';
---
<Base noHeader title="Creează un cont" crumbs={[{ href: '/cont', label: 'Cont' }]}>
  <section class="wrap narrow page page-auth">
    <SignUpForm client:only="preact">
      <Loader slot="fallback" />
    </SignUpForm>
  </section>
</Base>
<style>
  .page-auth { padding-block: 8px 20px; }
</style>
