---
import Base from '../../../layouts/Base.astro';
import { BOOKS, type Book } from '../../../lib/books';
import { exams, type ExamFile } from '../../../lib/content';
import MockStart from '../../../islands/MockStart';
import { ageLabel, type AgeGroup } from '../../../lib/age';

// When the real exams took place (they are added to the site after they happen).
const DATES: Record<string, Record<string, string>> = {
  '1-samuel': { 'sub12': 'sâmbătă, 24 octombrie 2026', '12-13': 'luni, 19 octombrie 2026', '14-15': 'luni, 19 octombrie 2026', '16-17': 'luni, 19 octombrie 2026', '18+': 'luni, 19 octombrie 2026' },
};
const dates = (slug: string) => DATES[slug] ?? {};

export function getStaticPaths() {
  return BOOKS.map((book) => ({ params: { book: book.slug }, props: { book, list: exams(book.slug) } }));
}
const { book, list } = Astro.props as { book: Book; list: ExamFile[] };
---
<Base title="Examene" description={`Examenele din ${book.name}, notate din 100.`}
  crumbs={[{ href: '/', label: 'Acasă' }, { href: `/${book.slug}`, label: book.name }]}>
  <section class="wrap narrow page" data-book={book.slug}>
    <h1>Examene</h1>

    <MockStart client:only="preact" book={book.slug}>
      <div slot="fallback" class="card mock-card skeleton"></div>
    </MockStart>

    <h2>Examene date</h2>
    {list.length === 0 && !dates(book.slug).sub12 ? (
      <p class="card empty muted">Datele examenelor pentru {book.name} nu sunt încă cunoscute. Le adăugăm când le aflăm.</p>
    ) : (
      <ul class="exams">
        {list.map((e) => (
          <li>
            <a class="card exam" href={`/${book.slug}/examene/${e.id}`} data-exam={e.id} data-age={e.age}>
              <span>
                <span class="exam-title">{ageLabel(e.age as AgeGroup)}</span>
                <span class="small muted">{e.title}, {e.year} · {e.questions.length} întrebări</span>
                {dates(book.slug)[e.age] && <span class="small muted">A avut loc {dates(book.slug)[e.age]}</span>}
              </span>
              <span class="best small" hidden></span>
            </a>
          </li>
        ))}
        {dates(book.slug).sub12 && !list.some((e) => e.age === 'sub12') && (
          <li class="card exam soon">
            <span>
              <span class="exam-title">{ageLabel('sub12')}</span>
              <span class="small muted">Examenul are loc {dates(book.slug).sub12}</span>
              <span class="small muted">Îl adăugăm aici după ce are loc.</span>
            </span>
          </li>
        )}
      </ul>
    )}
  </section>
</Base>

<script>
  import { effect } from '@preact/signals';
  import { level } from '../../../lib/level';
  import { progress } from '../../../lib/progress';

  let stop: (() => void) | undefined;
  document.addEventListener('astro:before-swap', () => stop?.());
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-book]');
    if (!root || !root.querySelector('[data-exam]')) return;
    const p = progress(root.dataset.book!);
    stop = effect(() => {
      const own = level.value;
      for (const a of root.querySelectorAll<HTMLElement>('[data-exam]')) {
        const best = p.value.exams[a.dataset.exam!]?.best;
        const badge = a.querySelector<HTMLElement>('.best')!;
        badge.hidden = best === undefined;
        badge.textContent = best === undefined ? '' : `${best}/100`;
        a.classList.toggle('mine', a.dataset.age === own);
      }
    });
  });
</script>

<style>
  .page { display: grid; gap: 16px; padding-block: 8px 32px; }
  .exams { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .exam { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; text-decoration: none; }
  .exam > span:first-child { display: flex; flex-direction: column; gap: 2px; }
  .exam-title { font-weight: 600; }
  .exam.mine { border-color: var(--oil); }
  .alb { background: var(--oil-soft); border-color: transparent; }
  .best { flex: none; padding: 4px 10px; border-radius: 999px; background: var(--ok-soft); color: var(--ok); font-weight: 600; }
  .chev { flex: none; color: var(--ink-3); }
  .empty { padding: 18px; }
  h2 { margin-top: 8px; }
</style>
