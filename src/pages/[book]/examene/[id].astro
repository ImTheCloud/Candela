---
import Loader from '../../../components/Loader.astro';
import Base from '../../../layouts/Base.astro';
import ExamRunner from '../../../islands/ExamRunner';
import { BOOKS, type Book } from '../../../lib/books';
import { exams, playable, type ExamFile } from '../../../lib/content';
import { ageLabel, type AgeGroup } from '../../../lib/age';

export function getStaticPaths() {
  return BOOKS.flatMap((book) => exams(book.slug).map((exam) => ({ params: { book: book.slug, id: exam.id }, props: { book, exam } })));
}
const { book, exam } = Astro.props as { book: Book; exam: ExamFile };
const questions = exam.questions.map((q) => playable(book.slug, q));
const title = `${exam.title}, ${ageLabel(exam.age as AgeGroup)}`;
---
<Base title={title} crumbs={[{ href: '/', label: 'Acasă' }, { href: `/${book.slug}`, label: book.name }, { href: `/${book.slug}/examene`, label: 'Examene' }]}>
  <section class="wrap narrow">
    <ExamRunner client:only="preact" book={book.slug} bookName={book.name} title={`${title} (${exam.year})`} examId={exam.id} questions={questions}>
      <Loader slot="fallback" />
    </ExamRunner>
  </section>
</Base>
