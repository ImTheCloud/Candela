---
import Base from '../../../layouts/Base.astro';
import { BOOKS, type Book } from '../../../lib/books';
import { chapterFiles, type ChapterFile } from '../../../lib/content';

// Not linked from the app: the page where a person reads every question before it is marked as checked.
export function getStaticPaths() {
  return BOOKS.map((book) => ({ params: { book: book.slug }, props: { book, files: [...chapterFiles(book.slug).values()].sort((a, b) => a.ch - b.ch) } }));
}
const { book, files } = Astro.props as { book: Book; files: ChapterFile[] };
---
<Base title={`Verificare ${book.name}`} crumbs={[{ href: '/', label: 'Acasă' }, { href: `/${book.slug}`, label: book.name }]}>
  <section class="wrap narrow page">
    <h1>Verificarea întrebărilor</h1>
    <p class="muted">Fiecare capitol, pe grupe de vârstă, cu răspunsurile. Un capitol verificat este marcat în fișierul lui („reviewed").</p>
    <ul class="list">
      {files.map((f) => (
        <li><a class="card row" href={`/${book.slug}/verificare/${f.ch}`}><span>Capitolul {f.ch}</span><span class={`small ${f.reviewed ? 'ok' : 'muted'}`}>{f.questions.length} întrebări · {f.reviewed ? 'verificat' : 'de verificat'}</span></a></li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .page { display: grid; gap: 14px; padding-block: 8px 32px; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .row { display: flex; justify-content: space-between; gap: 10px; padding: 14px 16px; text-decoration: none; box-shadow: none; }
  .ok { color: var(--ok); font-weight: 600; }
</style>
