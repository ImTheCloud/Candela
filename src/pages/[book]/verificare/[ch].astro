---
import Base from '../../../layouts/Base.astro';
import { LEVELS } from '../../../lib/age';
import { BOOKS, type Book } from '../../../lib/books';
import { chapterFiles, playable, type ChapterFile } from '../../../lib/content';
import { typeInfo, type Playable } from '../../../lib/questions';

export function getStaticPaths() {
  return BOOKS.flatMap((book) => [...chapterFiles(book.slug).values()].map((file) => ({ params: { book: book.slug, ch: String(file.ch) }, props: { book, file } })));
}
const { book, file } = Astro.props as { book: Book; file: ChapterFile };
const qs = file.questions.map((q) => playable(book.slug, q));
const chTitle = book.titles[file.ch - 1] ?? '';
const letters = ['a', 'b', 'c'];
const answer = (q: Playable) => {
  switch (q.t) {
    case 'tf': return q.a ? 'Adevărat' : 'Fals';
    case 'one': return `${letters[q.a]}) ${q.opts[q.a]}`;
    case 'multi': return q.a.length ? q.a.map((i) => `${letters[i]}) ${q.opts[i]}`).join('; ') : 'Niciun răspuns corect';
    case 'fill': return q.a.join(', ');
    case 'match': return '';
  }
};
---
<Base
  title={`Verificare ${book.name} ${file.ch}`}
  crumbs={[
    { href: '/', label: 'Acasă' },
    { href: '/admin/intrebari', label: 'Întrebări' },
    { href: `/${book.slug}/verificare`, label: book.name },
    { href: `/${book.slug}/verificare/${file.ch}`, label: `Cap. ${file.ch}` },
  ]}
>
  <section class="wrap narrow page">
    <div class="ch-head">
      <h1>{book.name} {file.ch}{chTitle ? `: ${chTitle}` : ''}</h1>
      <p class="muted">{file.questions.length} întrebări, {file.reviewed ? 'verificat' : 'de verificat'}</p>
    </div>

    <div class="lv-chips ch-filter" role="radiogroup" aria-label="Filtru nivel">
      <button type="button" role="radio" class="lv-chip" data-lv="usor" aria-checked="false">Ușor</button>
      <button type="button" role="radio" class="lv-chip" data-lv="mediu" aria-checked="false">Mediu</button>
      <button type="button" role="radio" class="lv-chip" data-lv="greu" aria-checked="false">Greu</button>
      <button type="button" role="radio" class="lv-chip" data-lv="all" aria-checked="true">Toate</button>
    </div>

    {LEVELS.map((g) => (
      <section class="age" data-age={g.id}>
        <h2>{g.label}</h2>
        {qs.filter((q) => q.age === g.id).map((q) => (
          <article class="card rq" id={q.id}>
            <p class="small muted"><strong>{typeInfo(q.t).short}</strong>, {q.ref}, {q.id}</p>
            {q.ctx && <p class="small muted">{q.ctx}</p>}
            <p class="rq-q">{q.q}</p>
            {(q.t === 'one' || q.t === 'multi') && <ol class="rq-opts" type="a">{q.opts.map((o, i) => <li class={(q.t === 'one' ? q.a === i : q.a.includes(i)) ? 'right' : ''}>{o}</li>)}</ol>}
            {q.t === 'match' && <ul class="rq-opts">{q.pairs.map(([l, r]) => <li><strong>{l}</strong> → {r}</li>)}</ul>}
            {q.t !== 'match' && <p class="rq-a">Răspuns: <strong>{answer(q)}</strong></p>}
            {q.explain && <p class="small">Explicație: {q.explain}</p>}
            <details><summary class="small">Versetele</summary>{q.cite.map(([l, t]) => <p class="rq-v"><sup>{l}</sup> {t}</p>)}</details>
          </article>
        ))}
      </section>
    ))}

    <div class="ch-foot">
      <a class="btn btn-ghost btn-sm" href="/admin/intrebari">← Înapoi la întrebări</a>
    </div>
  </section>
</Base>

<script>
  function setupFilter() {
    const container = document.querySelector('.ch-filter');
    if (!container) return;
    const buttons = container.querySelectorAll<HTMLButtonElement>('.lv-chip');
    const sections = document.querySelectorAll<HTMLElement>('.age[data-age]');

    function setFilter(lv: string) {
      buttons.forEach((btn) => {
        btn.setAttribute('aria-checked', btn.dataset.lv === lv ? 'true' : 'false');
      });
      sections.forEach((sec) => {
        const match = lv === 'all' || sec.dataset.age === lv;
        sec.style.display = match ? 'grid' : 'none';
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lv = btn.dataset.lv || 'all';
        setFilter(lv);
      });
    });
  }

  setupFilter();
  document.addEventListener('astro:page-load', setupFilter);
</script>

<style>
  .page { display: grid; gap: 14px; padding-block: 8px 32px; }
  .ch-head { display: grid; gap: 4px; }
  .ch-head h1 { margin: 0; font-size: 1.5rem; }
  .ch-head p { margin: 0; }
  .ch-filter { margin-top: 4px; }
  .age { display: grid; gap: 10px; padding-top: 12px; }
  .rq { display: grid; gap: 6px; padding: 14px 16px; box-shadow: none; }
  .rq-q { font-weight: 500; }
  .rq-opts { margin: 0; padding-left: 22px; display: grid; gap: 2px; }
  .rq-opts .right { color: var(--ok); font-weight: 600; }
  .rq-a { color: var(--ok); }
  .rq-v { font: 400 0.98rem/1.6 var(--f-bible); margin-top: 4px; }
  .ch-foot { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); display: flex; justify-content: center; }
  summary { cursor: pointer; color: var(--oil-ink); }
</style>
