---
import Base from '../../../layouts/Base.astro';
import { BOOKS, type Book } from '../../../lib/books';
import { chapterFiles } from '../../../lib/content';
import { getText } from '../../../lib/text';
import StartTest from '../../../islands/StartTest';
import BibleAudioReader from '../../../islands/BibleAudioReader';

export function getStaticPaths() {
  return BOOKS.flatMap((book) => {
    const text = getText(book.slug);
    if (!text) return [];
    return Object.entries(text).map(([ch, verses]) => ({
      params: { book: book.slug, ch },
      props: { book, ch: Number(ch), verses },
    }));
  });
}

const { book, ch, verses } = Astro.props as { book: Book; ch: number; verses: string[] };
const ready = chapterFiles(book.slug).has(ch);
const prev = ch > 1 ? ch - 1 : null;
const next = ch < book.chapters ? ch + 1 : null;
// "1 verset", "7 versete", "22 de versete"
const plural = (n: number, one: string, many: string) => (n === 1 ? `1 ${one}` : n % 100 >= 1 && n % 100 < 20 ? `${n} ${many}` : `${n} de ${many}`);
const count = plural(verses.length, 'verset', 'versete');
---
<Base title={`${book.name} ${ch}`} heading={{ title: `Capitolul ${ch}`, note: count }} backHome backUp crumbs={[{ href: '/', label: 'Acasă' }]}>
  <article class="wrap narrow reader" data-book={book.slug} data-ch={ch}>
    <div class="reader-head">
      <h2 class="reader-title">{book.titles[ch - 1]}</h2>
      <div class="text-size" role="group" aria-label="Mărimea textului">
        <button type="button" class="ts-btn ts-small" data-text-size="-1" aria-label="Text mai mic">A</button>
        <button type="button" class="ts-btn ts-big" data-text-size="1" aria-label="Text mai mare">A</button>
      </div>
    </div>
    <script is:inline>
      // the chosen size before the text is drawn (same steps as TEXT_SIZES below)
      try { var s = [1, 1.08, 1.15, 1.25, 1.38, 1.5, 1.65][parseInt(localStorage.getItem('candela_text_size'), 10)]; if (s) document.currentScript.parentElement.style.setProperty('--bible-size', s + 'rem'); } catch (e) {}
    </script>
    <BibleAudioReader client:only="preact" bookSlug={book.slug} bookName={book.name} ch={ch} totalChapters={book.chapters} title={book.titles[ch - 1]} verses={verses} />
    <div class="text">
      {verses.map((v, i) => (
        <p class="verse" id={`v${i + 1}`}><sup>{i + 1}</sup>{v}</p>
      ))}
    </div>
  </article>

  <nav class="pager" aria-label="Capitole">
    <div class="wrap narrow pager-stack">
    <div class="pager-row">
      {prev ? <a class="pager-btn" href={`/${book.slug}/citire/${prev}`} rel="prev" data-astro-prefetch="load" aria-label={`Capitolul ${prev}`}><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></a> : <span class="pager-btn" aria-hidden="true" />}
      {ready ? (
        <StartTest client:only="preact" book={book.slug} ch={ch} title={book.titles[ch - 1]}>
          <button slot="fallback" type="button" class="btn btn-primary btn-block">Începe întrebările</button>
        </StartTest>
      ) : <button type="button" class="btn btn-primary btn-block" disabled>Întrebări în pregătire</button>}
      {next ? <a class="pager-btn" href={`/${book.slug}/citire/${next}`} rel="next" data-astro-prefetch="load" aria-label={`Capitolul ${next}`}><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></a> : <span class="pager-btn" aria-hidden="true" />}
    </div>
    </div>
  </nav>

</Base>
<script>
  // Size of the Bible text, kept for the next visits; the steps go from small phones to reading glasses
  const TEXT_SIZES = [1, 1.08, 1.15, 1.25, 1.38, 1.5, 1.65];
  const KEY = 'candela_text_size';
  const DEFAULT = 2;

  function saved(): number {
    try {
      const v = parseInt(localStorage.getItem(KEY) ?? '', 10);
      if (v >= 0 && v < TEXT_SIZES.length) return v;
    } catch {}
    return DEFAULT;
  }

  function apply(i: number) {
    const reader = document.querySelector<HTMLElement>('.reader');
    if (!reader) return;
    reader.style.setProperty('--bible-size', `${TEXT_SIZES[i]}rem`);
    document.querySelectorAll<HTMLButtonElement>('[data-text-size]').forEach((b) => {
      b.disabled = b.dataset.textSize === '-1' ? i === 0 : i === TEXT_SIZES.length - 1;
    });
  }

  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-text-size]');
    if (!b) return;
    const i = Math.min(TEXT_SIZES.length - 1, Math.max(0, saved() + Number(b.dataset.textSize)));
    try { localStorage.setItem(KEY, String(i)); } catch {}
    apply(i);
  });
  document.addEventListener('astro:page-load', () => apply(saved()));
</script>
<style>
  :global(main:has(.pager)),
  :global(body:has(.pager) main) {
    padding-bottom: 0 !important;
  }
  .reader { padding-block: 16px calc(var(--pager-h, 68px) + 24px); }
  .reader-head { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; }
  .reader-title { flex: 1; min-width: 0; margin: 0; font: 600 1.2rem/1.3 var(--f-display); color: var(--ink); }
  .text-size { flex: none; display: flex; border: 1.5px solid var(--line); border-radius: var(--r-ctl); background: var(--surface); overflow: hidden; }
  .ts-btn {
    display: grid; place-items: center; width: 42px; height: 40px; padding: 0; border: 0; background: none;
    color: var(--ink); font-family: var(--f-bible); font-weight: 600; line-height: 1; cursor: pointer;
  }
  .ts-btn + .ts-btn { border-left: 1.5px solid var(--line); }
  .ts-small { font-size: 0.85rem; }
  .ts-big { font-size: 1.25rem; }
  .ts-btn:active:not(:disabled) { background: var(--surface-2); }
  .ts-btn:disabled { color: var(--ink-3); opacity: .45; cursor: default; }
  .ts-btn:focus-visible { outline: 3px solid var(--flame); outline-offset: -3px; }
  .text { font: 400 var(--bible-size, 1.15rem)/1.75 var(--f-bible); }
  .verse { margin: 0 0 2px; scroll-margin-top: 80px; }
  .reader.audio-active .verse { cursor: pointer; }
  .verse:target { outline: 2px solid var(--flame); outline-offset: 1px; }
  .verse.is-reading {
    background: rgba(224, 122, 59, 0.14);
    border-radius: 6px;
    padding: 2px 8px;
    margin-left: -8px;
    margin-right: -8px;
    box-shadow: 0 0 0 1.5px rgba(224, 122, 59, 0.4);
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }
  @media (hover: hover) {
    .reader.audio-active .verse:hover:not(.is-reading) {
      background: rgba(58, 39, 27, 0.04);
      border-radius: 6px;
    }
  }
  sup { font: 600 0.7rem var(--f-body); color: var(--oil-ink); margin-right: 4px; vertical-align: 0.5em; line-height: 0; }

  /* Thumb-reachable chapter navigation sticky at the bottom */
  .pager {
    position: sticky; bottom: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .pager-stack { padding-block: 8px; }
  .pager-row { display: grid; grid-template-columns: 48px 1fr 48px; align-items: center; gap: 10px; }
  .pager-btn {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    text-decoration: none; color: var(--ink);
  }
  a.pager-btn:active { background: var(--surface-2); }
  .pager-btn:last-child { justify-self: end; }
</style>
