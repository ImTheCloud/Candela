---
import Base from '../../../layouts/Base.astro';
import ChapterSheet from '../../../components/ChapterSheet.astro';
import { BOOKS, type Book } from '../../../lib/books';
import { getText } from '../../../lib/text';

export function getStaticPaths() {
  return BOOKS.flatMap((book) => {
    const text = getText(book.slug);
    if (!text) return [];
    return Object.entries(text).map(([ch, verses]) => ({
      params: { book: book.slug, ch },
      props: { book, ch: Number(ch), verses },
    }));
  });
}

const { book, ch, verses } = Astro.props as { book: Book; ch: number; verses: string[] };
const prev = ch > 1 ? ch - 1 : null;
const next = ch < book.chapters ? ch + 1 : null;
---
<Base title={`${book.name} ${ch}`} crumbs={[{ href: '/', label: 'Acasă' }, { href: `/${book.slug}`, label: book.name }]}>
  <article class="wrap narrow reader" data-book={book.slug} data-ch={ch}>
    <header class="reader-head">
      <h1>Capitolul {ch}</h1>
      <p class="reader-title">{book.titles[ch - 1]}</p>
    </header>
    <div class="text">
      {verses.map((v, i) => (
        <p class="verse" id={`v${i + 1}`}><sup>{i + 1}</sup>{v}</p>
      ))}
    </div>

    <a class="start" href={`/${book.slug}/exersare?capitol=${ch}&start=1`}>
      <span>Începe întrebările</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </a>
  </article>

  <nav class="pager" aria-label="Capitole">
    <div class="wrap narrow pager-row">
      {prev ? <a class="pager-btn" href={`/${book.slug}/citire/${prev}`} rel="prev" aria-label={`Capitolul ${prev}`}><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></a> : <span class="pager-btn" aria-hidden="true" />}
      <button class="pager-mid" type="button" data-open-sheet>{book.name} {ch}</button>
      {next ? <a class="pager-btn" href={`/${book.slug}/citire/${next}`} rel="next" aria-label={`Capitolul ${next}`}><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></a> : <span class="pager-btn" aria-hidden="true" />}
    </div>
  </nav>

  <ChapterSheet book={book} current={ch} />
</Base>
<style>
  .reader { padding-block: 8px 24px; }
  .reader-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 18px; }
  .reader-title { font: 500 1.15rem/1.3 var(--f-display); color: var(--ink-2); }
  .text { font: 400 1.15rem/1.75 var(--f-bible); }
  .verse { margin: 0 0 2px; scroll-margin-top: 80px; }
  .verse:target { outline: 2px solid var(--oil); outline-offset: 1px; }
  sup { font: 600 0.7rem var(--f-body); color: var(--oil-ink); margin-right: 4px; vertical-align: 0.5em; line-height: 0; }

  .start {
    display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 60px; margin-top: 32px;
    border-radius: 999px; background: var(--oil); color: var(--ink); text-decoration: none;
    font: 700 1.1rem var(--f-body); transition: background-color .15s, transform .1s;
  }
  .start:hover { background: color-mix(in srgb, var(--oil) 88%, white); }
  .start:active { transform: scale(0.98); }

  /* Thumb-reachable chapter navigation */
  .pager {
    position: sticky; bottom: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .pager-row { display: grid; grid-template-columns: 56px 1fr 56px; align-items: center; gap: 8px; height: 60px; }
  .pager-btn {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    text-decoration: none; color: var(--ink);
  }
  a.pager-btn:active { background: var(--surface-2); }
  .pager-btn:last-child { justify-self: end; }
  .pager-mid {
    justify-self: center; min-height: 44px; padding: 0 16px; border: 1px solid var(--line); border-radius: 999px;
    background: var(--surface); color: var(--ink); font: 600 1rem var(--f-body); cursor: pointer; white-space: nowrap;
  }
</style>
