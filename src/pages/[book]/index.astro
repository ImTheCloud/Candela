---
import Base from '../../layouts/Base.astro';
import BookHome from '../../components/BookHome.astro';
import { BOOKS, type Book } from '../../lib/books';

export function getStaticPaths() {
  return BOOKS.map((book) => ({ params: { book: book.slug }, props: { book } }));
}

const { book } = Astro.props as { book: Book };
---
<Base home title={book.name} description={`${book.name}: ${book.summary}`}>
  <BookHome book={book} />
</Base>
