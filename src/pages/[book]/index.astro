---
import Base from '../../layouts/Base.astro';
import { BOOKS, type Book } from '../../lib/books';
import { getText } from '../../lib/text';

export function getStaticPaths() {
  return BOOKS.map((book) => ({ params: { book: book.slug }, props: { book } }));
}

const { book } = Astro.props as { book: Book };
const text = getText(book.slug);
const chapters = Array.from({ length: book.chapters }, (_, i) => i + 1);
const base = `/${book.slug}`;

const modes = [
  { href: `${base}/exersare`, name: 'Pe capitole', text: 'Alegi capitolele, primești întrebări de toate tipurile.' },
  { href: `${base}/exersare?mod=tip`, name: 'Pe tip de întrebare', text: 'Doar adevărat/fals, doar completări, doar asocieri…' },
  { href: `${base}/greseli`, name: 'Greșelile mele', text: 'Întrebările greșite revin până le știi.' },
  { href: `${base}/examene`, name: 'Examene', text: 'Examenele de anul trecut și examene noi, notate din 100.' },
];
---
<Base title={book.name} description={`${book.name}: ${book.summary}`} crumbs={[{ href: '/', label: 'Acasă' }]}>
  <header class="wrap head">
    <h1>{book.name}</h1>
    <p class="muted">{book.summary}</p>
  </header>

  {text && (
    <section class="wrap block" aria-labelledby="read" data-book={book.slug} data-total={book.chapters}>
      <div class="card reading">
        <div class="row-between">
          <h2 id="read">Citește</h2>
          <span class="small muted read-count">0 din {book.chapters}</span>
        </div>
        <div class="bar" aria-hidden="true"><span class="bar-fill"></span></div>
        <a class="btn btn-primary btn-block continue" href={`${base}/citire/1`}>Începe cu capitolul 1</a>
        <ol class="chapters">
          {chapters.map((n) => (
            <li><a href={`${base}/citire/${n}`} data-ch={n} aria-label={`Capitolul ${n}`}>{n}</a></li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="wrap block" aria-labelledby="practice">
    <h2 id="practice" class="block-title">Exersează</h2>
    <ul class="modes">
      {modes.map((m) => (
        <li>
          <a class="card mode" href={m.href}>
            <span>
              <span class="mode-name">{m.name}</span>
              <span class="small muted">{m.text}</span>
            </span>
            <span class="chev" aria-hidden="true">›</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  import { effect } from '@preact/signals';
  import { progress } from '../../lib/progress';

  const section = document.querySelector<HTMLElement>('[data-book][data-total]');
  if (section) {
    const book = section.dataset.book!;
    const total = Number(section.dataset.total);
    const links = [...section.querySelectorAll<HTMLAnchorElement>('.chapters a')];
    const count = section.querySelector('.read-count')!;
    const fill = section.querySelector<HTMLElement>('.bar-fill')!;
    const cont = section.querySelector<HTMLAnchorElement>('.continue')!;
    const p = progress(book);
    effect(() => {
      const read = new Set(p.value.read);
      for (const a of links) a.classList.toggle('is-read', read.has(Number(a.dataset.ch)));
      count.textContent = `${read.size} din ${total}`;
      fill.style.width = `${(read.size / total) * 100}%`;
      const nextCh = links.map((a) => Number(a.dataset.ch)).find((n) => !read.has(n));
      cont.hidden = !nextCh;
      if (nextCh) {
        cont.href = `/${book}/citire/${nextCh}`;
        cont.textContent = read.size ? `Continuă cu capitolul ${nextCh}` : 'Începe cu capitolul 1';
      }
    });
  }
</script>

<style>
  .head { display: flex; flex-direction: column; gap: 6px; padding-block: 8px 4px; }
  .block { padding-top: 22px; }
  .block-title { margin-bottom: 12px; }
  .reading { display: grid; gap: 14px; padding: 18px; }
  .bar { height: 8px; border-radius: 999px; background: var(--surface-2); overflow: hidden; }
  .bar-fill { display: block; height: 100%; width: 0; background: var(--ok); border-radius: inherit; transition: width .3s; }
  .chapters {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(48px, 1fr));
  }
  .chapters a {
    display: grid; place-items: center; aspect-ratio: 1; border-radius: var(--r-sm);
    border: 1px solid var(--line); background: var(--bg);
    font: 600 1rem var(--f-body); text-decoration: none; font-variant-numeric: tabular-nums;
  }
  .chapters a.is-read { background: var(--ok-soft); border-color: transparent; color: var(--ok); }
  .modes { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .mode { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; text-decoration: none; }
  .mode > span:first-child { display: flex; flex-direction: column; gap: 2px; }
  .mode-name { font-weight: 600; }
  .chev { font-size: 1.6rem; color: var(--ink-3); line-height: 1; }
</style>
