---
import Loader from '../../components/Loader.astro';
import Base from '../../layouts/Base.astro';
import Mistakes from '../../islands/Mistakes';
import { BOOKS, type Book } from '../../lib/books';

export function getStaticPaths() {
  return BOOKS.map((book) => ({ params: { book: book.slug }, props: { book } }));
}
const { book } = Astro.props as { book: Book };
---
<Base title="Greșelile mele" crumbs={[{ href: '/', label: 'Acasă' }, { href: `/${book.slug}`, label: book.name }]}>
  <section class="wrap narrow">
    <Mistakes client:only="preact" book={book.slug} bookName={book.name}>
      <Loader slot="fallback" />
    </Mistakes>
  </section>
</Base>
